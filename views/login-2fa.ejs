<%- include('partials/head') %>
<div class="auth card form">
  <h1>Two-step verification</h1>
  <p class="muted small">Open your authenticator app and enter the 6-digit code for <%= settings.store_name %>.</p>
  <% if (typeof error !== 'undefined' && error) { %><div class="flash error"><%= error %></div><% } %>
  <form method="post" action="/login/2fa">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Code<input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}" maxlength="7" required autofocus class="code-input"></label>
    <button class="btn block" type="submit">Verify</button>
  </form>
  <p class="muted small center">Lost your phone? The store owner can reset 2FA from the server (see the README).</p>
</div>
<%- include('partials/foot') %>
