<%- include('partials/head') %>
<div class="auth card form">
  <h1>Forgot your password?</h1>
  <% if (sent) { %>
    <div class="flash success">If an account exists for <strong><%= values.email %></strong>, we've emailed a link to reset your password. It works for 1 hour.</div>
    <p class="muted small">Don't see it? Check your spam folder, or <a href="/forgot">try again</a>.</p>
  <% } else { %>
    <p class="muted small">Enter the email you signed up with and we'll send you a link to choose a new password.</p>
    <form method="post" action="/forgot">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Email<input type="email" name="email" required autocomplete="email" value="<%= values.email || '' %>"></label>
      <button class="btn block" type="submit">Send reset link</button>
    </form>
  <% } %>
  <p class="muted small center"><a href="/login">Back to log in</a></p>
</div>
<%- include('partials/foot') %>
