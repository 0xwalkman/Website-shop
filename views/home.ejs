<%- include('partials/head') %>
<section class="hero">
  <div>
    <p class="eyebrow">New season</p>
    <h1><%= settings.tagline %></h1>
    <p class="muted">Free shipping on orders over <%= money(settings.free_shipping_over_cents) %>.</p>
    <a class="btn" href="/shop">Shop now</a>
  </div>
</section>

<% if (categories.length) { %>
<section>
  <div class="section-head"><h2>Categories</h2><a href="/shop">See all</a></div>
  <div class="cat-scroller">
    <% categories.forEach(c => { %>
      <a class="cat" href="/shop?category=<%= c.slug %>">
        <div class="cat-img"><% if (c.image) { %><img src="<%= c.image %>" alt="" loading="lazy"><% } else { %><span><%= c.name.slice(0,1) %></span><% } %></div>
        <span><%= c.name %></span>
      </a>
    <% }) %>
  </div>
</section>
<% } %>

<section>
  <div class="section-head"><h2>New arrivals</h2><a href="/shop">See all</a></div>
  <% if (products.length) { %>
    <div class="grid"><% products.forEach(p => { %><%- include('partials/product-card', { p }) %><% }) %></div>
  <% } else { %><p class="muted">No products yet.</p><% } %>
</section>

<section class="promo">
  <div>
    <h2>Share & earn <%= settings.commission_rate %>%</h2>
    <p>Get your personal link, share it with friends, and earn <%= settings.commission_rate %>% of every order they place — paid out in USDC.</p>
  </div>
  <a class="btn light" href="/account/affiliate">Get my link</a>
</section>
<%- include('partials/foot') %>
