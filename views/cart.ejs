<%- include('partials/head') %>
<h1 class="page-title">Your cart</h1>
<% if (!cart.items.length) { %>
  <div class="empty"><p class="muted">Your cart is empty.</p><a class="btn" href="/shop">Start shopping</a></div>
<% } else { %>
  <div class="cart-layout">
    <div class="cart-items">
      <% cart.items.forEach(i => { %>
        <div class="cart-item">
          <a class="cart-thumb" href="/p/<%= i.slug %>"><% if (i.image) { %><img src="<%= i.image %>" alt=""><% } else { %><div class="ph"><%= i.product_name.slice(0,1) %></div><% } %></a>
          <div class="cart-info">
            <a href="/p/<%= i.slug %>"><strong><%= i.product_name %></strong></a>
            <div class="muted small">Size <%= i.size %> · <%= money(i.price_cents) %></div>
            <form method="post" action="/cart/update" class="inline-qty">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="variant_id" value="<%= i.id %>">
              <select name="qty" onchange="this.form.submit()" aria-label="Quantity">
                <% for (let n = 0; n <= Math.min(20, Math.max(i.stock, i.qty)); n++) { %><option value="<%= n %>" <%= n === i.qty ? 'selected' : '' %>><%= n === 0 ? 'Remove' : n %></option><% } %>
              </select>
            </form>
          </div>
          <div class="line-total"><%= money(i.line_cents) %></div>
        </div>
      <% }) %>
    </div>
    <div class="summary card">
      <div class="row"><span>Subtotal</span><span><%= money(cart.subtotal) %></span></div>
      <div class="row"><span>Shipping</span><span><%= cart.shipping ? money(cart.shipping) : 'Free' %></span></div>
      <% if (cart.shipping && settings.free_shipping_over_cents) { %><p class="muted small">Add <%= money(settings.free_shipping_over_cents - cart.subtotal) %> more for free shipping.</p><% } %>
      <div class="row total"><span>Total</span><span><%= money(cart.total) %></span></div>
      <a class="btn block" href="/checkout">Checkout</a>
    </div>
  </div>
<% } %>
<%- include('partials/foot') %>
