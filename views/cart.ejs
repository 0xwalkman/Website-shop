<%- include('partials/head') %>
<h1 class="page-title">Your cart</h1>
<% if (!cart.items.length) { %>
  <div class="empty"><div class="big-emoji">🛍</div><h2>Your cart is empty</h2><p class="muted">Let's fix that. New pieces are waiting.</p><a class="btn" href="/shop">Start shopping</a></div>
<% } else { %>
  <div class="cart-layout">
    <div class="cart-items">
      <% cart.items.forEach(i => { %>
        <div class="cart-item">
          <a class="cart-thumb" href="/p/<%= i.slug %>"><% if (i.image) { %><img src="<%= i.image %>" alt=""><% } else { %><div class="ph"><%= i.product_name.slice(0,1) %></div><% } %></a>
          <div class="cart-info">
            <a href="/p/<%= i.slug %>"><strong><%= i.product_name %></strong></a>
            <div class="muted small"><%= i.color ? i.color + " · " : "" %><%= /size/i.test(i.size) ? i.size : 'Size ' + i.size %> ·<%= money(i.price_cents) %><% if (i.compare_at_cents > i.price_cents) { %> <s><%= money(i.compare_at_cents) %></s><% } %></div>
            <form method="post" action="/cart/update" class="qty-stepper">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="variant_id" value="<%= i.id %>">
              <button name="qty" value="<%= i.qty - 1 %>" aria-label="<%= i.qty === 1 ? 'Remove' : 'One less' %>"><%= i.qty === 1 ? '🗑' : '−' %></button>
              <span aria-label="Quantity"><%= i.qty %></span>
              <button name="qty" value="<%= i.qty + 1 %>" aria-label="One more" <%= i.qty >= Math.min(20, i.stock) ? 'disabled' : '' %>>+</button>
              <% if (i.qty > 1) { %><button class="link-btn remove-line" name="qty" value="0">Remove</button><% } %>
            </form>
          </div>
          <div class="line-total"><%= money(i.line_cents) %></div>
        </div>
      <% }) %>
    </div>
    <div class="summary card">
      <div class="row"><span>Subtotal</span><span><%= money(cart.subtotal) %></span></div>
      <% if (cart.discount) { %>
        <div class="row discount-row"><span>🏷 <%= cart.discount.code %> <small class="muted">(<%= cart.discount.label %>)</small></span><span>−<%= money(cart.discountCents) %></span></div>
        <form method="post" action="/cart/discount" class="link-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="cart">
          <button class="link-btn" name="remove" value="1">Remove code</button>
        </form>
      <% } else { %>
        <form method="post" action="/cart/discount" class="discount-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="cart">
          <input name="code" placeholder="Discount code" aria-label="Discount code" autocomplete="off" autocapitalize="characters">
          <button class="btn small outline" type="submit">Apply</button>
        </form>
      <% } %>
      <div class="row"><span>Shipping</span><span><%= cart.shipping ? money(cart.shipping) : 'Free, worldwide' %></span></div>
      <% if (cart.shipping && settings.free_shipping_over_cents) { %><p class="muted small">Add <%= money(settings.free_shipping_over_cents - cart.subtotal) %> more for free shipping.</p><% } %>
      <div class="row total"><span>Total</span><span><%= money(cart.total) %></span></div>
      <a class="btn block" href="/checkout">Checkout securely</a>
      <p class="muted small center">🔒 <%= payLabel %>.</p>
    </div>
  </div>
<% } %>
<%- include('partials/foot') %>
