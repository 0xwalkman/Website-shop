<%- include('partials/head') %>
<h1 class="page-title">Checkout</h1>
<p class="muted page-sub">Step 1 of 2: where should we send it, and how would you like to pay?</p>
<% if (typeof error !== 'undefined' && error) { %><div class="flash error"><%= error %></div><% } %>
<% if (!methods.length) { %>
  <div class="flash info">Online payment is being set up and will be available very soon. Your cart is saved in the meantime.</div>
<% } %>
<div class="cart-layout">
  <form method="post" action="/checkout" class="card form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <h2>Contact</h2>
    <label>Email<input name="email" type="email" required value="<%= values.email || '' %>" autocomplete="email" placeholder="you@example.com"></label>
    <label>Phone, for the courier<input name="phone" type="tel" required value="<%= values.phone || '' %>" autocomplete="tel" placeholder="+1 555 123 4567"></label>

    <h2>Delivery address</h2>
    <label>Full name<input name="name" required value="<%= values.name || '' %>" autocomplete="name"></label>
    <label>Country
      <select name="country" required autocomplete="country">
        <option value="">Choose your country</option>
        <% countries.forEach(c => { %><option value="<%= c.code %>" <%= values.country === c.code ? 'selected' : '' %>><%= c.name %></option><% }) %>
      </select>
    </label>
    <label>Street address<input name="address" required value="<%= values.address || '' %>" autocomplete="street-address" placeholder="Street, building, apartment"></label>
    <div class="field-pair">
      <label>City<input name="city" required value="<%= values.city || '' %>" autocomplete="address-level2"></label>
      <label>Postal code<input name="postal_code" value="<%= values.postal_code || '' %>" autocomplete="postal-code" placeholder="If you have one"></label>
    </div>
    <label>Delivery notes (optional)<textarea name="notes" rows="2" placeholder="Gate code, landmark, best time to deliver…"><%= values.notes || '' %></textarea></label>

    <% if (methods.length) { %>
      <h2>Payment</h2>
      <% const chosen = methods.includes(values.payment_method) ? values.payment_method : methods[0]; %>
      <div class="pay-options">
        <% if (methods.includes('stripe')) { %>
          <label class="pay-option">
            <input type="radio" name="payment_method" value="stripe" <%= chosen === 'stripe' ? 'checked' : '' %>>
            <span>
              <strong>💳 Card</strong>
              <small>Visa, Mastercard and more, on Stripe's secure page. Your card details never touch our servers.</small>
            </span>
          </label>
        <% } %>
        <% if (methods.includes('binance')) { %>
          <label class="pay-option">
            <input type="radio" name="payment_method" value="binance" <%= chosen === 'binance' ? 'checked' : '' %>>
            <span>
              <strong>🟡 Binance Pay</strong>
              <small><%= settings.currency === 'usd' ? `Pay ${(cart.total / 100).toFixed(2)} ${binanceCurrency}` : 'Pay in crypto' %> from your Binance app. Scan the QR code or log in on the next page.</small>
            </span>
          </label>
        <% } %>
      </div>
    <% } %>
    <p class="muted small customs-note">🌍 Shipping outside our country? Your local customs may charge import duties or taxes on delivery. These aren't included in our prices. <a href="/page/shipping" target="_blank">Learn more</a></p>
    <button class="btn block" type="submit" <%= methods.length ? '' : 'disabled' %>>Continue to payment · <%= money(cart.total) %></button>
    <p class="muted small center">By placing your order you agree to our <a href="/page/terms" target="_blank">Terms</a> and <a href="/page/returns" target="_blank">Returns policy</a>.</p>
    <% if (!user) { %><p class="muted small center">Already shop with us? <a href="/login?next=/checkout">Log in</a> to keep all your orders in one place.</p><% } %>
  </form>
  <div class="summary card">
    <h2>Your order</h2>
    <% cart.items.forEach(i => { %>
      <div class="row small"><span><%= i.qty %> × <%= i.product_name %> (<%= [i.color, i.size].filter(Boolean).join(" / ") %>)</span><span><%= money(i.line_cents) %></span></div>
    <% }) %>
    <hr>
    <div class="row"><span>Subtotal</span><span><%= money(cart.subtotal) %></span></div>
      <% if (cart.discount) { %>
        <div class="row discount-row"><span>🏷 <%= cart.discount.code %> <small class="muted">(<%= cart.discount.label %>)</small></span><span>−<%= money(cart.discountCents) %></span></div>
        <form method="post" action="/cart/discount" class="link-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="checkout">
          <button class="link-btn" name="remove" value="1">Remove code</button>
        </form>
      <% } else { %>
        <form method="post" action="/cart/discount" class="discount-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="checkout">
          <input name="code" placeholder="Discount code" aria-label="Discount code" autocomplete="off" autocapitalize="characters">
          <button class="btn small outline" type="submit">Apply</button>
        </form>
      <% } %>
    <div class="row"><span>Shipping</span><span><%= cart.shipping ? money(cart.shipping) : 'Free, worldwide' %></span></div>
    <div class="row total"><span>Total</span><span><%= money(cart.total) %></span></div>
  </div>
</div>
<%- include('partials/foot') %>
