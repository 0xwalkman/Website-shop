<%- include('partials/head') %>
<h1 class="page-title">Checkout</h1>
<% if (typeof error !== 'undefined' && error) { %><div class="flash error"><%= error %></div><% } %>
<div class="cart-layout">
  <form method="post" action="/checkout" class="card form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <h2>Delivery details</h2>
    <label>Full name<input name="name" required value="<%= values.name || '' %>" autocomplete="name"></label>
    <label>Email<input name="email" type="email" required value="<%= values.email || '' %>" autocomplete="email"></label>
    <label>Phone<input name="phone" type="tel" required value="<%= values.phone || '' %>" autocomplete="tel"></label>
    <label>Address<input name="address" required value="<%= values.address || '' %>" autocomplete="street-address"></label>
    <label>City<input name="city" required value="<%= values.city || '' %>" autocomplete="address-level2"></label>
    <label>Notes (optional)<textarea name="notes" rows="2"><%= values.notes || '' %></textarea></label>
    <div class="pay-note">💵 Payment: <strong>cash on delivery</strong>. We'll contact you to confirm your order.</div>
    <button class="btn block" type="submit">Place order · <%= money(cart.total) %></button>
    <% if (!user) { %><p class="muted small">Have an account? <a href="/login?next=/checkout">Log in</a> to track your orders.</p><% } %>
  </form>
  <div class="summary card">
    <h2>Order summary</h2>
    <% cart.items.forEach(i => { %>
      <div class="row small"><span><%= i.qty %> × <%= i.product_name %> (<%= i.size %>)</span><span><%= money(i.line_cents) %></span></div>
    <% }) %>
    <hr>
    <div class="row"><span>Subtotal</span><span><%= money(cart.subtotal) %></span></div>
    <div class="row"><span>Shipping</span><span><%= cart.shipping ? money(cart.shipping) : 'Free' %></span></div>
    <div class="row total"><span>Total</span><span><%= money(cart.total) %></span></div>
  </div>
</div>
<%- include('partials/foot') %>
