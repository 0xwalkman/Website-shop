<%- include('partials/head') %>
<div class="product">
  <div class="product-media">
    <% if (product.image) { %><img src="<%= product.image %>" alt="<%= product.name %>"><% } else { %><div class="ph big"><%= product.name.slice(0,1) %></div><% } %>
  </div>
  <div class="product-info">
    <% if (product.category_name) { %><a class="muted small" href="/shop?category=<%= product.category_slug %>"><%= product.category_name %></a><% } %>
    <h1><%= product.name %></h1>
    <% const inStock = variants.filter(v => v.stock > 0); const first = inStock[0] || variants[0]; %>
    <div class="price big" id="price"><%= first ? money(first.price_cents) : '' %></div>

    <form method="post" action="/cart/add" id="add-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="label-row"><strong>Choose your size</strong><span class="muted small" id="stock-note"></span></div>
      <div class="sizes">
        <% variants.forEach(v => { %>
          <label class="size <%= v.stock <= 0 ? 'disabled' : '' %>">
            <input type="radio" name="variant_id" value="<%= v.id %>" data-price="<%= money(v.price_cents) %>" data-stock="<%= v.stock %>"
              <%= v.stock <= 0 ? 'disabled' : '' %> <%= first && v.id === first.id && v.stock > 0 ? 'checked' : '' %> required>
            <span><%= v.size %></span>
          </label>
        <% }) %>
      </div>
      <div class="qty-row">
        <label class="muted small" for="qty">Qty</label>
        <div class="stepper">
          <button type="button" data-step="-1" aria-label="Decrease">−</button>
          <input id="qty" type="number" name="qty" value="1" min="1" max="20" inputmode="numeric">
          <button type="button" data-step="1" aria-label="Increase">+</button>
        </div>
      </div>
      <% if (inStock.length) { %>
        <div class="actions">
          <button class="btn outline" type="submit">Add to cart</button>
          <button class="btn" type="submit" name="buy_now" value="1">Buy now</button>
        </div>
        <ul class="mini-perks">
          <% if (freeShipping) { %><li>🌍 Free shipping worldwide</li><% } %>
          <li>🔒 <%= payLabel %></li>
        </ul>
      <% } else { %>
        <button class="btn" disabled>Sold out in every size</button>
        <p class="muted small">This one flew off the shelves. Take a look at the pieces below.</p>
      <% } %>
    </form>

    <% if (product.description) { %><div class="desc"><%= product.description %></div><% } %>

    <div class="share-box">
      <% if (user) { %>
        <% const link = `${baseUrl}/p/${product.slug}?ref=${user.referral_code}`; %>
        <strong>Know someone who'd wear this?</strong>
        <span class="small">Send them your link. If they buy, you earn <%= settings.commission_rate %>% of their order in USDC.</span>
        <div class="copy-row"><input readonly value="<%= link %>" id="plink"><button class="btn small" type="button" data-copy="#plink">Copy</button></div>
        <button class="btn small outline" type="button" data-share="<%= link %>" data-title="<%= product.name %>">Share…</button>
      <% } else { %>
        <span>💸 <strong>Love it? Share it.</strong> Earn <%= settings.commission_rate %>% in USDC when friends buy through your link. <a href="/register?next=<%= encodeURIComponent('/p/' + product.slug) %>">Create a free account</a></span>
      <% } %>
    </div>
  </div>
</div>

<% if (related.length) { %>
<section>
  <div class="section-head"><h2>Goes well with</h2></div>
  <div class="grid"><% related.forEach(p => { %><%- include('partials/product-card', { p }) %><% }) %></div>
</section>
<% } %>
<%- include('partials/foot') %>
