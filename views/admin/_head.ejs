<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex">
  <title><%= title %> · Admin · <%= settings.store_name %></title>
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body class="admin">
<header class="topbar dark">
  <div class="wrap topbar-inner">
    <a class="logo" href="/admin"><%= settings.store_name %> <span class="chip">Admin</span></a>
    <div class="top-actions"><a class="chip" href="/" target="_blank">View store ↗</a></div>
  </div>
  <nav class="admin-nav wrap">
    <% const tabs = [['/admin', 'Dashboard'], ['/admin/products', 'Products'], ['/admin/categories', 'Categories'], ['/admin/orders', 'Orders', adminPendingOrders], ['/admin/affiliates', 'Affiliates'], ['/admin/withdrawals', 'Withdrawals', adminPendingWithdrawals], ['/admin/settings', 'Settings']]; %>
    <% tabs.forEach(([href, label, count]) => { const active = href === '/admin' ? (path === '/admin' || path === '/admin/') : (path === href || path.startsWith(href + '/')); %>
      <a href="<%= href %>" class="<%= active ? 'active' : '' %>"><%= label %><% if (count) { %> <span class="badge inline"><%= count %></span><% } %></a>
    <% }) %>
  </nav>
</header>
<main class="wrap page">
<% if (flash) { %><div class="flash <%= flash.type %>"><%= flash.message %></div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="flash error"><%= error %></div><% } %>
