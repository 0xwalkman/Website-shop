<%- include('_head') %>
<div class="section-head">
  <h1 class="page-title">Order #<%= order.id %></h1>
  <span class="status <%= order.status %>"><%= order.status === 'unpaid' ? 'awaiting payment' : order.status %></span>
</div>
<% if (order.status === 'unpaid') { %><div class="flash info">The customer is on the <%= order.payment_method === 'binance' ? 'Binance Pay' : 'PayPal' %> payment page, or left it. Unpaid checkouts cancel themselves and return their stock after about an hour.</div><% } %>
<div class="two-col">
  <div class="card">
    <h2>Items</h2>
    <% items.forEach(i => { %>
      <div class="row"><span><%= i.qty %> × <%= i.product_name %> <span class="muted">(<%= [i.color, i.size].filter(Boolean).join(" / ") %>)</span></span><span><%= money(i.price_cents * i.qty) %></span></div>
    <% }) %>
    <hr>
    <div class="row"><span>Subtotal</span><span><%= money(order.subtotal_cents) %></span></div>
    <% if (order.discount_cents) { %><div class="row"><span>Discount (<%= order.discount_code %>)</span><span>−<%= money(order.discount_cents) %></span></div><% } %>
    <div class="row"><span>Shipping</span><span><%= money(order.shipping_cents) %></span></div>
    <div class="row total"><span>Total</span><span><%= money(order.total_cents) %></span></div>
  </div>
  <div class="card">
    <h2>Customer</h2>
    <p><strong><%= order.customer_name %></strong><br>
      <a href="mailto:<%= order.email %>"><%= order.email %></a><br>
      <a href="tel:<%= order.phone %>"><%= order.phone %></a><br>
      <%= order.address %><br><%= order.city %><%= order.postal_code ? ' ' + order.postal_code : '' %><br><strong><%= order.country %></strong></p>
    <% if (order.notes) { %><p class="muted">Note: <%= order.notes %></p><% } %>
    <p class="muted small">Placed <%= order.created_at %> UTC<% if (order.paid_at) { %> · paid <%= order.paid_at %> UTC<% } %> · updated <%= order.updated_at %> UTC</p>
    <p class="small">Paid with: <strong><%= order.payment_method === 'binance' ? 'Binance Pay' : order.payment_method === 'paypal' ? 'PayPal' : 'Card (Stripe, before the switch to PayPal)' %></strong></p>
    <% if (order.paypal_order_id) { %><p class="small">PayPal order: <code><%= order.paypal_order_id %></code><% if (order.paypal_capture_id) { %><br>PayPal transaction: <code><%= order.paypal_capture_id %></code><% } %></p><% } %>
    <% if (order.stripe_payment_intent) { %><p class="small">Stripe payment: <code><%= order.stripe_payment_intent %></code></p><% } %>
    <% if (order.binance_trade_no) { %><p class="small">Binance order: <code><%= order.binance_trade_no %></code><% if (order.binance_transaction_id) { %><br>Transaction: <code><%= order.binance_transaction_id %></code><% } %></p><% } %>

    <h2>Update status</h2>
    <form method="post" action="/admin/orders/<%= order.id %>/status" class="form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="status-picker">
        <% statuses.forEach(st => { %>
          <label class="size"><input type="radio" name="status" value="<%= st %>" <%= order.status === st ? 'checked' : '' %>><span><%= st %></span></label>
        <% }) %>
      </div>
      <fieldset class="tracking-box">
        <legend>Tracking <span class="muted small">(needed when marking shipped)</span></legend>
        <label>Carrier
          <select name="tracking_carrier">
            <% carriers.forEach(c => { %><option value="<%= c %>" <%= (order.tracking_carrier === c || (!carriers.includes(order.tracking_carrier) && c === 'Other' && order.tracking_carrier)) ? 'selected' : '' %>><%= c === 'Other' ? 'Other carrier' : c %></option><% }) %>
          </select>
        </label>
        <label>Other carrier name (optional)<input name="tracking_carrier_other" value="<%= order.tracking_carrier && !carriers.includes(order.tracking_carrier) ? order.tracking_carrier : '' %>" placeholder="e.g. Poste Maroc"></label>
        <label>Tracking number<input name="tracking_number" value="<%= order.tracking_number || '' %>" autocomplete="off" spellcheck="false"></label>
        <label>Tracking link (optional)<input name="tracking_url" value="" placeholder="Leave empty to build it automatically"></label>
        <label class="check"><input type="checkbox" name="no_tracking" value="1"> Ship without tracking</label>
        <% if (order.tracking_url) { %><p class="small">Current link: <a href="<%= order.tracking_url %>" target="_blank" rel="noopener">open tracking ↗</a></p><% } %>
      </fieldset>
      <button class="btn" type="submit">Update</button>
      <p class="muted small">Cancelling returns items to stock but does <strong>not</strong> refund the customer<%= order.payment_method === 'paypal' ? ' (use the refund button for that)' : '' %>. The affiliate commission becomes withdrawable when the order is <strong>delivered</strong>.</p>
    </form>
    <% if (order.payment_method !== 'paypal' && order.paid_at && order.status !== 'refunded') { %>
      <p class="muted small">To refund a Binance Pay order, send the refund from your Binance merchant dashboard, then set the status to <strong>refunded</strong> here. That returns the items to stock and cancels the affiliate commission.</p>
    <% } %>
    <% if (paypalReady && order.payment_method === 'paypal' && order.paypal_capture_id && order.paid_at && ['paid', 'shipped', 'delivered', 'cancelled'].includes(order.status)) { %>
      <form method="post" action="/admin/orders/<%= order.id %>/refund" data-confirm="Refund <%= money(order.total_cents) %> to the customer through PayPal? This cannot be undone.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn danger block" type="submit">Refund <%= money(order.total_cents) %> via PayPal</button>
      </form>
    <% } %>
  </div>
</div>
<% if (commission) { %>
  <div class="card">
    <h2>Affiliate commission</h2>
    <div class="row"><span>Affiliate</span><span><%= commission.affiliate_name %> (<%= commission.affiliate_email %>)</span></div>
    <div class="row"><span>Commission</span><span><%= usdc(commission.amount_cents) %> (<%= commission.rate %>% of <%= money(commission.order_amount_cents) %>)</span></div>
    <div class="row"><span>Status</span><span class="status <%= commission.status %>"><%= commission.status %></span></div>
  </div>
<% } %>
<p><a class="btn outline" href="/admin/orders">← All orders</a></p>
<%- include('_foot') %>
