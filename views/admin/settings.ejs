<%- include('_head') %>
<h1 class="page-title">Settings</h1>
<div class="card">
  <h2>Payments (Stripe)</h2>
  <div class="row"><span>Stripe API key</span><span class="status <%= stripeReady ? 'delivered' : 'cancelled' %>"><%= stripeReady ? 'connected' : 'missing' %></span></div>
  <div class="row"><span>Webhook secret</span><span class="status <%= webhookReady ? 'delivered' : 'pending' %>"><%= webhookReady ? 'connected' : 'missing' %></span></div>
  <% if (!stripeReady || !webhookReady) { %>
    <p class="muted small">Set <code>STRIPE_SECRET_KEY</code> and <code>STRIPE_WEBHOOK_SECRET</code> on the server and restart it. Point a Stripe webhook at <code><%= baseUrl %>/stripe/webhook</code> with the events <code>checkout.session.completed</code>, <code>checkout.session.async_payment_succeeded</code>, <code>checkout.session.async_payment_failed</code>, <code>checkout.session.expired</code> and <code>charge.refunded</code>. See the README for details.</p>
  <% } %>
</div>
<div class="card">
  <h2>Payments (Binance Pay)</h2>
  <div class="row"><span>Binance Pay API key</span><span class="status <%= binanceReady ? 'delivered' : 'cancelled' %>"><%= binanceReady ? 'connected' : 'missing' %></span></div>
  <% if (binanceReady) { %>
    <p class="muted small">USD orders are charged 1:1 in <strong><%= binanceCurrency %></strong>. Other store currencies are converted by Binance at the market rate.</p>
  <% } else { %>
    <p class="muted small">Set <code>BINANCE_PAY_API_KEY</code> and <code>BINANCE_PAY_SECRET_KEY</code> on the server and restart it. Binance notifies <code><%= baseUrl %>/binance/webhook</code> automatically (it must be reachable over the internet). See the README for details.</p>
  <% } %>
</div>
<div class="card">
  <h2>Email</h2>
  <div class="row"><span>Email sending (SMTP)</span><span class="status <%= smtpReady ? 'delivered' : 'pending' %>"><%= smtpReady ? 'connected' : 'not set up' %></span></div>
  <% if (!smtpReady) { %><p class="muted small">Emails (order confirmations, shipping updates, password resets) are being saved to <code>data/outbox</code> instead of sent. Add your email provider's SMTP details on the server to send them for real. See the README.</p><% } %>
  <p class="muted small">Last 7 days: <% if (!emailStats.length) { %>no emails yet<% } else { %><%= emailStats.map(e => `${e.n} ${e.status}`).join(' · ') %><% } %></p>
  <% if (failedEmails.length) { %>
    <div class="flash error small">Some emails could not be sent:<br><% failedEmails.forEach(e => { %><%= e.created_at %>: <%= e.subject %> → <%= e.to_addr %> (<%= e.error %>)<br><% }) %></div>
  <% } %>
</div>
<form method="post" action="/admin/settings" class="form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="two-col">
    <div class="card">
      <h2>Store</h2>
      <label>Store name<input name="store_name" value="<%= settings.store_name %>" maxlength="60"></label>
      <label>Tagline<input name="tagline" value="<%= settings.tagline %>" maxlength="140"></label>
      <label>Currency
        <select name="currency">
          <% Object.entries(currencies).forEach(([code, sym]) => { %><option value="<%= code %>" <%= settings.currency === code ? 'selected' : '' %>><%= code.toUpperCase() %> (<%= sym %>)</option><% }) %>
        </select>
      </label>
      <p class="muted small">Affiliates are paid 1 USDC per 1 unit of this currency, so USD is recommended.</p>
      <label>Shipping fee per order (0 = free shipping)<input name="shipping" inputmode="decimal" value="<%= (settings.shipping_cents / 100).toFixed(2) %>"></label>
      <label>Free shipping over (0 = not used)<input name="free_shipping_over" inputmode="decimal" value="<%= (settings.free_shipping_over_cents / 100).toFixed(2) %>"></label>
    </div>
    <div class="card">
      <h2>Contact & business details</h2>
      <p class="muted small">Shown on the contact page, in policy pages and in emails.</p>
      <label>Customer service email<input name="contact_email" type="email" value="<%= settings.contact_email %>" placeholder="hello@yourdomain.com"></label>
      <label>WhatsApp number (shows a chat button)<input name="whatsapp_number" value="<%= settings.whatsapp_number %>" placeholder="+212 600 000000"></label>
      <label>Send new-order alerts to (optional)<input name="admin_notify_email" type="email" value="<%= settings.admin_notify_email %>" placeholder="Defaults to the customer service email"></label>
      <label>Business / legal name (optional)<input name="business_name" value="<%= settings.business_name %>"></label>
      <label>Business address (optional)<input name="business_address" value="<%= settings.business_address %>"></label>
    </div>
    <div class="card">
      <h2>Shipping & returns promises</h2>
      <p class="muted small">Used in the Shipping and Returns pages and in emails. Make sure they match what you can really deliver.</p>
      <label>Order processing time<input name="processing_days" value="<%= settings.processing_days %>"></label>
      <label>Delivery time after shipping<input name="delivery_estimate" value="<%= settings.delivery_estimate %>"></label>
      <label>Return window (days)<input name="returns_days" type="number" min="0" max="365" value="<%= settings.returns_days %>"></label>
    </div>
    <div class="card">
      <h2>Affiliate program</h2>
      <label>Commission rate (%)<input name="commission_rate" inputmode="decimal" value="<%= settings.commission_rate %>"></label>
      <p class="muted small">Applies to new orders. Existing commissions keep the rate they were created with.</p>
      <label>Minimum withdrawal (USDC)<input name="min_withdrawal" inputmode="decimal" value="<%= (settings.min_withdrawal_cents / 100).toFixed(2) %>"></label>
    </div>
  </div>
  <button class="btn" type="submit">Save settings</button>
</form>
<%- include('_foot') %>
