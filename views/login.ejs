<%- include('partials/head') %>
<div class="auth card form">
  <h1>Welcome back</h1>
  <p class="muted small">Log in to track your orders and see your earnings.</p>
  <% if (typeof error !== 'undefined' && error) { %><div class="flash error"><%= error %></div><% } %>
  <form method="post" action="/login">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="next" value="<%= next %>">
    <label>Email<input type="email" name="email" required value="<%= values.email || '' %>" autocomplete="email"></label>
    <label>Password<input type="password" name="password" required autocomplete="current-password"></label>
    <p class="small right forgot-link"><a href="/forgot">Forgot password?</a></p>
    <button class="btn block" type="submit">Log in</button>
  </form>
  <p class="muted small center">New to <%= settings.store_name %>? <a href="/register<%= next ? `?next=${encodeURIComponent(next)}` : '' %>">Create an account</a></p>
</div>
<%- include('partials/foot') %>
