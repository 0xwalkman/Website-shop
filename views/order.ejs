<%- include('partials/head') %>
<% const first = order.customer_name.split(' ')[0]; const isPaid = ['paid', 'shipped', 'delivered'].includes(order.status); %>
<% if (placed && isPaid) { %>
  <div class="success-hero">
    <div class="big-emoji">🎉</div>
    <h1>It's yours, <%= first %>!</h1>
    <p class="muted">Payment received and order #<%= order.id %> is confirmed. We'll get it packed and on its way to <%= order.city %>, <%= order.country %>.<%= order.shipping_cents === 0 ? ' Shipping is on us.' : '' %></p>
  </div>
<% } else if (placed && order.status === 'unpaid') { %>
  <div class="success-hero">
    <div class="big-emoji">⏳</div>
    <h1>Confirming your payment…</h1>
    <p class="muted">This usually takes a few seconds<%= order.payment_method === 'binance' ? ', sometimes a minute for crypto' : '' %>. Refresh the page in a moment. If you paid, your order is safe.</p>
    <a class="btn outline" href="/order/<%= order.id %>">Refresh</a>
  </div>
<% } else { %>
  <h1 class="page-title">Order #<%= order.id %></h1>
<% } %>

<% if (isPaid) { %>
  <ol class="tracker">
    <li class="done">Paid</li>
    <li class="<%= ['shipped', 'delivered'].includes(order.status) ? 'done' : '' %>">Shipped</li>
    <li class="<%= order.status === 'delivered' ? 'done' : '' %>">Delivered</li>
  </ol>
<% } %>

<div class="card">
  <div class="row"><span>Status</span><span class="status <%= order.status %>"><%= order.status === 'unpaid' ? 'awaiting payment' : order.status %></span></div>
  <div class="row"><span>Ordered</span><span><%= order.created_at.slice(0, 16) %> UTC</span></div>
  <div class="row"><span>Delivering to</span><span class="right"><%= order.customer_name %><br><%= order.address %><br><%= order.city %><%= order.postal_code ? ' ' + order.postal_code : '' %><%= order.country ? ', ' + order.country : '' %></span></div>
  <hr>
  <% items.forEach(i => { %>
    <div class="row small"><span><%= i.qty %> × <%= i.product_name %> (<%= i.size %>)</span><span><%= money(i.price_cents * i.qty) %></span></div>
  <% }) %>
  <hr>
  <div class="row"><span>Subtotal</span><span><%= money(order.subtotal_cents) %></span></div>
  <div class="row"><span>Shipping</span><span><%= order.shipping_cents ? money(order.shipping_cents) : 'Free' %></span></div>
  <div class="row total"><span><%= isPaid || order.status === 'refunded' ? 'Paid' : 'Total' %></span><span><%= money(order.total_cents) %></span></div>
</div>

<% if (order.status === 'cancelled' && !order.paid_at) { %>
  <p class="muted">This checkout was not completed, so you were not charged. <a href="/cart">Back to your cart</a></p>
<% } %>

<% if (placed && isPaid) { %>
  <div class="promo slim">
    <div>
      <h2>Get <%= settings.commission_rate %>% back on your friends' orders</h2>
      <p>Love what you got? Share your <%= settings.store_name %> link and earn <%= settings.commission_rate %>% in USDC on every order it brings in.</p>
    </div>
    <a class="btn light" href="<%= user ? '/account/affiliate' : '/register?next=/account/affiliate' %>"><%= user ? 'Get my link' : 'Create a free account' %></a>
  </div>
<% } %>
<p><a class="btn outline" href="/shop">Keep shopping</a></p>
<%- include('partials/foot') %>
