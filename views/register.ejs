<%- include('partials/head') %>
<div class="auth card form">
  <h1>Join <%= settings.store_name %></h1>
  <ul class="benefits">
    <li>📦 Track every order in one place</li>
    <li>🔗 Get your personal share link instantly</li>
    <li>💸 Earn <%= settings.commission_rate %>% in USDC on every order it brings in</li>
  </ul>
  <% if (typeof error !== 'undefined' && error) { %><div class="flash error"><%= error %></div><% } %>
  <form method="post" action="/register">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="next" value="<%= next %>">
    <label>Name<input name="name" required value="<%= values.name || '' %>" autocomplete="name"></label>
    <label>Email<input type="email" name="email" required value="<%= values.email || '' %>" autocomplete="email"></label>
    <label>Password (at least 8 characters)<input type="password" name="password" required minlength="8" autocomplete="new-password"></label>
    <button class="btn block" type="submit">Create my free account</button>
  </form>
  <p class="muted small center">Already registered? <a href="/login<%= next ? `?next=${encodeURIComponent(next)}` : '' %>">Log in</a></p>
</div>
<%- include('partials/foot') %>
