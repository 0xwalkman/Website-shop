<%- include('partials/head') %>
<div class="cart-layout">
  <div>
    <article class="prose card">
      <h1><%= page.title %></h1>
      <%- page.html %>
    </article>
    <% if (settings.whatsapp_number) { %>
      <a class="btn block whatsapp" target="_blank" rel="noopener" href="https://wa.me/<%= settings.whatsapp_number.replace(/\D/g, '') %>">💬 Chat with us on WhatsApp</a>
    <% } %>
  </div>
  <form method="post" action="/contact" class="card form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <h2>Send us a message</h2>
    <% if (typeof error !== 'undefined' && error) { %><div class="flash error"><%= error %></div><% } %>
    <label>Name<input name="name" required value="<%= values.name || '' %>" autocomplete="name"></label>
    <label>Email<input type="email" name="email" required value="<%= values.email || '' %>" autocomplete="email"></label>
    <label>Order number (optional)<input name="order" value="<%= values.order || '' %>" inputmode="numeric" placeholder="e.g. 1042"></label>
    <label>Subject<input name="subject" value="<%= values.subject || '' %>" placeholder="Sizing, returns, delivery…"></label>
    <label>Message<textarea name="message" rows="5" required><%= values.message || '' %></textarea></label>
    <label class="hp" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"></label>
    <button class="btn block" type="submit">Send message</button>
  </form>
</div>
<%- include('partials/foot') %>
