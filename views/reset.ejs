<%- include('partials/head') %>
<div class="auth card form">
  <h1>Choose a new password</h1>
  <% if (typeof error !== 'undefined' && error) { %><div class="flash error"><%= error %></div><% } %>
  <form method="post" action="/reset/<%= token %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>New password (at least 8 characters)<input type="password" name="password" required minlength="8" autocomplete="new-password" autofocus></label>
    <button class="btn block" type="submit">Save new password</button>
  </form>
  <p class="muted small">For your security, you'll be signed out on all other devices.</p>
</div>
<%- include('partials/foot') %>
