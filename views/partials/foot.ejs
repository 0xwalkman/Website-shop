</main>
<footer class="footer wrap">
  <div class="footer-grid">
    <div>
      <p class="footer-brand"><%= settings.store_name %></p>
      <p class="muted"><%= settings.tagline %></p>
    </div>
    <ul class="footer-perks">
      <% if (freeShipping) { %><li>🌍 Free shipping worldwide</li><% } %>
      <li>🔒 <%= payLabel %></li>
      <li>💸 <a href="/account/affiliate">Earn <%= settings.commission_rate %>% sharing your link</a></li>
    </ul>
  </div>
  <nav class="footer-links">
    <a href="/page/shipping">Shipping</a>
    <a href="/page/returns">Returns</a>
    <a href="/contact">Contact</a>
    <a href="/page/terms">Terms</a>
    <a href="/page/privacy">Privacy</a>
    <a href="/page/affiliate-terms">Affiliate rules</a>
  </nav>
  <p class="muted small">© <%= new Date().getFullYear() %> <%= settings.store_name %></p>
</footer>
<% if (settings.whatsapp_number) { %>
  <a class="wa-float" href="https://wa.me/<%= settings.whatsapp_number.replace(/\D/g, '') %>?text=<%= encodeURIComponent(`Hi ${settings.store_name}! `) %>" target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
    <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><path fill="#fff" d="M16 3C9 3 3.3 8.6 3.3 15.6c0 2.5.7 4.8 2 6.8L3.2 29l6.8-2.1c1.9 1 4 1.6 6 1.6 7 0 12.7-5.6 12.7-12.6C28.7 8.6 23 3 16 3zm0 23.1c-1.9 0-3.8-.5-5.4-1.5l-.4-.2-4 1.2 1.3-3.9-.3-.4c-1.1-1.7-1.7-3.6-1.7-5.6C5.5 9.9 10.2 5.3 16 5.3S26.5 9.9 26.5 15.6 21.8 26.1 16 26.1zm5.8-7.8c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7.1c-.3-.2-1.3-.5-2.5-1.5-.9-.8-1.5-1.8-1.7-2.1s0-.5.1-.6l.5-.6c.2-.2.2-.3.3-.5s0-.4 0-.6-.7-1.7-1-2.3c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4s-1.2 1.1-1.2 2.7 1.2 3.1 1.4 3.3 2.4 3.6 5.7 5c.8.3 1.4.5 1.9.7.8.3 1.5.2 2.1.1.6-.1 1.9-.8 2.2-1.5s.3-1.4.2-1.5c-.1-.2-.3-.3-.6-.4z"/></svg>
  </a>
<% } %>
<div class="cookie-note" id="cookie-note" hidden>
  <span>🍪 We only use the cookies needed to run the store: your cart, your login and your referral link. No ads, no tracking. <a href="/page/privacy">Privacy</a></span>
  <button type="button" class="btn small light" id="cookie-ok">OK</button>
</div>
<nav class="bottom-nav">
  <a href="/" class="<%= path === '/' ? 'active' : '' %>"><span>🏠</span>Home</a>
  <a href="/shop" class="<%= path === '/shop' ? 'active' : '' %>"><span>👕</span>Shop</a>
  <a href="/cart" class="<%= path === '/cart' ? 'active' : '' %>"><span>🛍<% if (cartCount) { %><i class="dot"><%= cartCount %></i><% } %></span>Cart</a>
  <a href="/account/affiliate" class="<%= path === '/account/affiliate' ? 'active' : '' %>"><span>💸</span>Earn</a>
  <a href="/account" class="<%= path === '/account' || path === '/login' ? 'active' : '' %>"><span>👤</span><%= user ? 'Account' : 'Log in' %></a>
</nav>
<script src="/public/js/app.js" defer></script>
</body>
</html>
