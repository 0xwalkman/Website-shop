<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#111111">
  <% const pageTitle = title ? `${title} · ${settings.store_name}` : `${settings.store_name} · ${settings.tagline}`;
     const m = typeof meta !== 'undefined' && meta ? meta : {};
     const pageDesc = m.description || `${settings.tagline} ${freeShipping ? 'Free shipping worldwide on every order. ' : ''}${payLabel}.`; %>
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDesc %>">
  <meta property="og:site_name" content="<%= settings.store_name %>">
  <meta property="og:title" content="<%= title || settings.store_name %>">
  <meta property="og:description" content="<%= pageDesc %>">
  <meta property="og:type" content="<%= m.image ? 'product' : 'website' %>">
  <% if (m.image) { %><meta property="og:image" content="<%= m.image %>"><meta name="twitter:card" content="summary_large_image"><% } %>
  <% if (m.canonical) { %><link rel="canonical" href="<%= m.canonical %>"><meta property="og:url" content="<%= m.canonical %>"><% } %>
  <% if (m.jsonld) { %><script type="application/ld+json"><%- JSON.stringify(m.jsonld).replace(/</g, '\\u003c') %></script><% } %>
  <link rel="stylesheet" href="/public/css/style.css">
  <% if (typeof csrfToken !== 'undefined') { %><meta name="csrf-token" content="<%= csrfToken %>"><% } %>
</head>
<body>
<% if (freeShipping) { %><div class="announce">🌍 Free shipping worldwide, on every order</div><% } %>
<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="logo" href="/"><%= settings.store_name %></a>
    <nav class="desk-nav">
      <a href="/shop" class="<%= path === '/shop' ? 'active' : '' %>">Shop</a>
      <% navCategories.slice(0, 5).forEach(c => { %><a href="/shop?category=<%= c.slug %>"><%= c.name %></a><% }) %>
      <a href="/account/affiliate" class="<%= path === '/account/affiliate' ? 'active' : '' %>">Earn 💸</a>
    </nav>
    <div class="top-actions">
      <form action="/shop" method="get" class="search">
        <input type="search" name="q" placeholder="Search" aria-label="Search products">
      </form>
      <% if (user && user.is_admin) { %><a class="chip dark" href="/admin">Admin</a><% } %>
      <a class="icon-btn desk-only" href="/account" aria-label="Account">👤</a>
      <a class="icon-btn" href="/cart" aria-label="Cart">🛍<span class="badge" data-cart-count <%= cartCount ? '' : 'hidden' %>><%= cartCount %></span></a>
    </div>
  </div>
</header>
<main class="wrap page">
<% if (flash) { %><div class="flash <%= flash.type %>"><%= flash.message %></div><% } %>
