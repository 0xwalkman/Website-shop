# Copy to .env and fill in. Never commit .env.

# Your domain without https:// (used by Caddy for the HTTPS certificate)
DOMAIN=yourdomain.com
BASE_URL=https://yourdomain.com
COOKIE_SECURE=true
# A long random string, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# First owner account (created on first start)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Start with the demo products? Set to false for a clean store.
SEED_DEMO=false

# Stripe (card payments) - dashboard.stripe.com > Developers
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Binance Pay - merchant portal > API management
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET_KEY=
BINANCE_PAY_CURRENCY=USDT

# Email (any SMTP provider: Resend, Postmark, Brevo, Mailgun, Gmail/Workspace...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Outouf <hello@yourdomain.com>

# Backups: daily copies of the database in data/backups (kept 14 days)
BACKUP_KEEP_DAYS=14
